# 数据库
DATABASE_URL=sqlite:///./medicine.db

# 微信小程序
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# AI大模型（智谱GLM）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4v

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=True
